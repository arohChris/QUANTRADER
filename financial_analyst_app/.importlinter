[importlinter]
root_package = shared
include_external_packages = True

[importlinter:contract:core-never-imports-modules]
name = Core (shared/core) must never import modules/* (directionality is law — §33)
type = forbidden
source_modules = shared.core
forbidden_modules = modules

[importlinter:contract:contracts-never-imports-engines]
name = Contracts (shared/contracts) must never import engines or services
type = forbidden
source_modules = shared.contracts
forbidden_modules = shared.core

[importlinter:contract:no-cross-tenant-without-context]
name = All DB access must go via tenant_context (enforced via grep in CI — this is a placeholder)
type = forbidden
source_modules = shared
forbidden_modules = modules

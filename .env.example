# QUANTRADER2 — environment placeholders (COPY to .env — never commit .env)
# =============================================================================
# Account mode: demo (fake money) | live (real money)
# Optional override of config/accounts.yaml mode — used by human or auto-bot.
ACCOUNT_MODE=demo

# Environment: development | testing | paper | canary | production
ENVIRONMENT=development

# Platform public-feed app id (M2.1 market-data) — already defaulted in
# config/brokers/deriv.yaml; set only to override.
DERIV_APP_ID=1089

# Vault key (M1.4) — 32 url-safe base64; generate once, never commit.
# VAULT_KEY=

# G1 WARM engine — TimescaleDB/Postgres dev password (financial_analyst_app/infra/docker-compose.yml).
# Dev-only value; pick any string, lives in .env only (never committed).
TIMESCALE_DEV_PASSWORD=

# ---- DEMO placeholders (fake money) — fill when demo account issued -------
DERIV_DEMO_ACCOUNT_ID=
DERIV_DEMO_API_TOKEN=
MT5_DEMO_ACCOUNT_ID=
MT5_DEMO_API_TOKEN=
HEADWAY_DEMO_ACCOUNT_ID=
HEADWAY_DEMO_API_TOKEN=

# ---- LIVE placeholders (real money) — fill only when going live ----------
# Also set live.enabled: true + mode: live in config/accounts.yaml (or ACCOUNT_MODE=live).
DERIV_LIVE_ACCOUNT_ID=
DERIV_LIVE_API_TOKEN=
MT5_LIVE_ACCOUNT_ID=
MT5_LIVE_API_TOKEN=
HEADWAY_LIVE_ACCOUNT_ID=
HEADWAY_LIVE_API_TOKEN=
